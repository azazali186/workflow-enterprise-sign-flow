# AeroXe SignFlow backend configuration (all values are examples)
# Copy to .env and adjust before running. Never commit real secrets.

# --- Server ---
PORT=8080
ENV=development                 # development | production
LOG_LEVEL=info
MAX_BODY_SIZE=10485760          # 10 MB request body limit
READ_TIMEOUT=30s                # per-request read timeout
WRITE_TIMEOUT=30s               # per-request write timeout
IDLE_TIMEOUT=120s               # keep-alive idle timeout
SHUTDOWN_TIMEOUT=15s
CORS_ALLOWED_ORIGINS=           # comma-separated allow-list, e.g. https://app.example.com
                                # empty = same-origin only; '*' = any (development only)

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://signflow:signflow@localhost:5432/signflow?sslmode=disable

# --- Redis (distributed cache, rate limit, sessions, locks) ---
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MIN=300

# --- NATS (event streaming for the outbox relay) ---
NATS_URL=nats://localhost:4222
OUTBOX_POLL_INTERVAL=2s

# --- Auth ---
JWT_SECRET=change-me-to-a-32-byte-random-secret!!
JWT_EXPIRY=2h
ADMIN_EMAIL=admin@signflow.local
ADMIN_PASSWORD=ChangeMe_Str0ng!

# --- Encryption (AES-256-GCM; derive from a strong random secret) ---
ENCRYPTION_KEY=change-me-32-byte-encryption-key!!

# --- WebSocket ---
WS_MAX_CONNECTIONS=1000
