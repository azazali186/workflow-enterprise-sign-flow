# SignFlow Console — frontend environment
# Copy to .env.local and adjust. All variables are optional.

# Base URL for API calls. When empty, requests go to the same origin and the
# Vite dev proxy (/api -> VITE_API_PROXY) handles routing.
# VITE_API_BASE=

# Dev-only: backend target for the /api proxy.
# VITE_API_PROXY=http://localhost:8080

# Optional: run the console on a custom dev port (default 5173).
# VITE_PORT=5173
